# Supabase - Obrigatorio para funcionamento do app
# Obtenha em: https://app.supabase.com (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Variaveis server-side (mesmo valor, sem VITE_ prefix)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot - Opcional (para notificacoes)
# Crie um bot em @BotFather no Telegram e obtenha o token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
